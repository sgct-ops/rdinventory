# --- Database (Neon or Supabase Postgres). Use the POOLED url for DATABASE_URL on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth.js (generate with: npx auth secret)
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin(s). They are created as ADMIN on first Google sign-in. Everyone else must be added in Users.
ADMIN_EMAILS="shantanu@carbontree.com"

# Vercel Cron sends this as a Bearer token to /api/cron/* (any long random string)
CRON_SECRET=""

# --- TEST COPY ONLY -----------------------------------------------------
# APP_ENV="test"        shows a TEST COPY badge and allows `npm run seed:demo`
# DEV_LOGIN="true"      email-only sign-in for local testing. Ignored on Vercel production.
