{
  "name": "rajdanga-fabric",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "local": "tsx --env-file-if-exists=.env scripts/local.mts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.mts",
    "db:push": "drizzle-kit push",
    "seed": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts",
    "seed:demo": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts --demo",
    "prepare": "node scripts/check-secrets.mjs --install-hook",
    "check:secrets": "node scripts/check-secrets.mjs --all"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "bwip-js": "^4.11.4",
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.26",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^16.14.0-beta.17",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
